(*
  Run with:
    proverif -lib <hax>/hax-lib/proof-libs/proverif/primitives.pvl \
             -lib <hax>/hax-lib/proof-libs/proverif/result.pvl \
             -lib <hax>/hax-lib/proof-libs/proverif/cryptolib.pvl  \
             -lib missingdecl.pvl \
             -lib lib.pvl your_analysis.pv

  These libraries ship with hax.

  primitives.pvl declares the symbols this file uses but does not
  define: the public channel c, the construct_fail sink,
  bitstring_default and bitstring_err, the Some/None and True/False
  constructors, the nat_0 to nat_16 literal constants, and the
  rust_primitives, core, and hax_lib helpers.

  result.pvl models Result and its methods.
  This model was extracted without --result-errors: a Result is its
  Ok payload and producing an Err ends the trace, so error paths are
  pruned from the model.

  cryptolib.pvl is the shared Dolev-Yao crypto model (hash, AEAD,
  KDF, DH, KEM, signatures, MAC, serialization) that a crate wires
  itself to with #[hax_lib::proverif::replace_body("crypto__...")].
  It is needed whenever the crate does so, and harmless otherwise.

  missingdecl.pvl, extracted next to this file, declares every symbol
  this file uses that none of these libraries defines, such as string
  literals and integer literals above 16. Each is left abstract:
  replace its declaration by a definition — by hand or from another
  crate's extraction — or keep it as an ideal-functionality boundary.
*)

(* Only typechecks with result.pvl loaded. *)
letfun hax_result_model_check__new_tests() = hax_result_model__result.

event Recorded(bitstring).
(* src: src/legacy/proverif-divergence/lib.rs:7:0-7:64 new_tests__legacy__proverif_divergence__lib__record *)
letfun new_tests__legacy__proverif_divergence__lib__record(x: bitstring) = event Recorded(x); x.
(* src: src/legacy/proverif-divergence/lib.rs:12:0-17:1 new_tests__legacy__proverif_divergence__lib__panic_arg *)
letfun new_tests__legacy__proverif_divergence__lib__panic_arg(x: bitstring) =
  let wildcard = (let hax__cond0 = rust_primitives__hax__machine_int__eq(x, nat_0) in
  let (=True()) = hax__cond0
    in (let hax__never = (core__panicking__panic_fmt(
      core__fmt__rt__Impl_1__new_v1(
        rust_primitives__hax__array_cons(string_lit__bad_x20, rust_primitives__hax__array_nil()),
        rust_primitives__hax__array_cons(core__fmt__rt__Impl__new_display(
          rust_primitives__hax__Tuple1__Tuple1__0(
            rust_primitives__hax__Tuple1__Tuple1(
              new_tests__legacy__proverif_divergence__lib__record(nat_1)
            )
          )
        ), rust_primitives__hax__array_nil())
      )
    )) in bitstring_err())
    else rust_primitives__hax__Tuple0__Tuple0) in
  x.
(* src: src/legacy/proverif-divergence/lib.rs:19:0-22:1 new_tests__legacy__proverif_divergence__lib__alert *)
letfun new_tests__legacy__proverif_divergence__lib__alert(x: bitstring) =
  let wildcard = new_tests__legacy__proverif_divergence__lib__record(x) in
  core__panicking__panic(string_lit__explicit_x20panic).
(* src: src/legacy/proverif-divergence/lib.rs:24:0-29:1 new_tests__legacy__proverif_divergence__lib__diverging_call *)
letfun new_tests__legacy__proverif_divergence__lib__diverging_call(o: bitstring) =
  let Some(v) = o in v
  else let None() = o in
    (let hax__never = (new_tests__legacy__proverif_divergence__lib__alert(
      nat_9
    )) in bitstring_err())
  else bitstring_err().