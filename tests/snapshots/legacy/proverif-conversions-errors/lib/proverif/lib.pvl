(*
  Run with:
    proverif -lib <hax>/hax-lib/proof-libs/proverif/primitives.pvl \
             -lib <hax>/hax-lib/proof-libs/proverif/result_errors.pvl \
             -lib <hax>/hax-lib/proof-libs/proverif/cryptolib.pvl  \
             -lib missingdecl.pvl \
             -lib lib.pvl your_analysis.pv

  These libraries ship with hax.

  primitives.pvl declares the symbols this file uses but does not
  define: the public channel c, the construct_fail sink,
  bitstring_default and bitstring_err, the Some/None and True/False
  constructors, the nat_0 to nat_16 literal constants, and the
  rust_primitives, core, and hax_lib helpers.

  result_errors.pvl models Result and its methods.
  This model was extracted with --result-errors: Ok and Err are
  constructors, so error paths stay reachable.

  cryptolib.pvl is the shared Dolev-Yao crypto model (hash, AEAD,
  KDF, DH, KEM, signatures, MAC, serialization) that a crate wires
  itself to with #[hax_lib::proverif::replace_body("crypto__...")].
  It is needed whenever the crate does so, and harmless otherwise.

  missingdecl.pvl, extracted next to this file, declares every symbol
  this file uses that none of these libraries defines, such as string
  literals and integer literals above 16. Each is left abstract:
  replace its declaration by a definition — by hand or from another
  crate's extraction — or keep it as an ideal-functionality boundary.
*)

(* Only typechecks with result_errors.pvl loaded. *)
letfun hax_result_model_check__new_tests() = hax_result_model__result_errors.

event Recorded(bitstring).
(* src: src/legacy/proverif-conversions-errors/lib.rs:8:0-8:64 new_tests__legacy__proverif_conversions_errors__lib__record *)
letfun new_tests__legacy__proverif_conversions_errors__lib__record(x: bitstring) =
  event Recorded(x); x.
(* src: src/legacy/proverif-conversions-errors/lib.rs:13:0-15:1 new_tests__legacy__proverif_conversions_errors__lib__check *)
letfun new_tests__legacy__proverif_conversions_errors__lib__check(x: bitstring) =
  let hax__cond0 = rust_primitives__hax__machine_int__eq(x, nat_0) in
  let (=True()) = hax__cond0 in core__result__Result__Err(nat_0) else core__result__Result__Ok(x).
(* src: src/legacy/proverif-conversions-errors/lib.rs:17:0-20:1 new_tests__legacy__proverif_conversions_errors__lib__unwrap_compared *)
letfun new_tests__legacy__proverif_conversions_errors__lib__unwrap_compared(x: bitstring) =
  let hax__cond0 = rust_primitives__hax__machine_int__eq(
    core__result__Impl__unwrap(new_tests__legacy__proverif_conversions_errors__lib__check(x)),
    nat_5
  ) in
  let (=True()) = hax__cond0
    in new_tests__legacy__proverif_conversions_errors__lib__record(nat_1)
    else nat_0.