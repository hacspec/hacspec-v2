(*
  Run with:
    proverif -lib <hax>/hax-lib/proof-libs/proverif/primitives.pvl \
             -lib <hax>/hax-lib/proof-libs/proverif/result.pvl \
             -lib <hax>/hax-lib/proof-libs/proverif/cryptolib.pvl  \
             -lib missingdecl.pvl \
             -lib lib.pvl your_analysis.pv

  These libraries ship with hax.

  primitives.pvl declares the symbols this file uses but does not
  define: the public channel c, the construct_fail sink,
  bitstring_default and bitstring_err, the Some/None and True/False
  constructors, the nat_0 to nat_16 literal constants, and the
  rust_primitives, core, and hax_lib helpers.

  result.pvl models Result and its methods.
  This model was extracted without --result-errors: a Result is its
  Ok payload and producing an Err ends the trace, so error paths are
  pruned from the model.

  cryptolib.pvl is the shared Dolev-Yao crypto model (hash, AEAD,
  KDF, DH, KEM, signatures, MAC, serialization) that a crate wires
  itself to with #[hax_lib::proverif::replace_body("crypto__...")].
  It is needed whenever the crate does so, and harmless otherwise.

  missingdecl.pvl, extracted next to this file, declares every symbol
  this file uses that none of these libraries defines, such as string
  literals and integer literals above 16. Each is left abstract:
  replace its declaration by a definition — by hand or from another
  crate's extraction — or keep it as an ideal-functionality boundary.
*)

(* Only typechecks with result.pvl loaded. *)
letfun hax_result_model_check__new_tests() = hax_result_model__result.

(*****************************************************************)
(*  WARNINGS — branches the model may not follow as Rust does.   *)
(*                                                               *)
(*  Each `HAX WARNING` below marks an `if` or `match` on a value *)
(*  the model cannot always evaluate. When it cannot, no arm of  *)
(*  a `match` is taken (the trace ends) and an `if` takes its    *)
(*  `else` branch, whatever Rust does. A query about the other   *)
(*  branch may then hold for lack of any trace.                  *)
(*                                                               *)
(*  - 6 × conversion of the library modelled as the identity, although its types are represented differently *)
(*****************************************************************)

event Recorded(bitstring).
(* src: src/legacy/proverif-conversions/lib.rs:7:0-7:64 new_tests__legacy__proverif_conversions__lib__record *)
letfun new_tests__legacy__proverif_conversions__lib__record(x: bitstring) = event Recorded(x); x.
(* src: src/legacy/proverif-conversions/lib.rs:12:0-18:1 new_tests__legacy__proverif_conversions__lib__into_option *)
letfun new_tests__legacy__proverif_conversions__lib__into_option(x: bitstring) =
  let hax__scrut0 = (* HAX WARNING: conversion of the library modelled as the identity, although its types are represented differently *) (x) in
  let Some(v) = hax__scrut0 in new_tests__legacy__proverif_conversions__lib__record(v)
  else let None() = hax__scrut0 in nat_0
  else bitstring_err().
(* src: src/legacy/proverif-conversions/lib.rs:20:0-23:1 new_tests__legacy__proverif_conversions__lib__bool_into *)
letfun new_tests__legacy__proverif_conversions__lib__bool_into(b: bitstring) =
  new_tests__legacy__proverif_conversions__lib__record(
    (* HAX WARNING: conversion of the library modelled as the identity, although its types are represented differently *) (b)
  ).
(* src: src/legacy/proverif-conversions/lib.rs:25:0-27:1 new_tests__legacy__proverif_conversions__lib__widening *)
letfun new_tests__legacy__proverif_conversions__lib__widening(x: bitstring) = x.
(* src: src/legacy/proverif-conversions/lib.rs:29:0-32:1 new_tests__legacy__proverif_conversions__lib__from_bytes *)
letfun new_tests__legacy__proverif_conversions__lib__from_bytes(wildcard: bitstring) =
  let hax__cond0 = rust_primitives__hax__machine_int__eq(
    (* HAX WARNING: conversion of the library modelled as the identity, although its types are represented differently *) (rust_primitives__hax__array_cons(nat_0, rust_primitives__hax__array_cons(nat_0, rust_primitives__hax__array_cons(nat_0, rust_primitives__hax__array_cons(nat_1, rust_primitives__hax__array_nil()))))),
    nat_1
  ) in
  let (=True()) = hax__cond0
    in new_tests__legacy__proverif_conversions__lib__record(nat_1)
    else nat_0.
(* src: src/legacy/proverif-conversions/lib.rs:34:0-36:1 new_tests__legacy__proverif_conversions__lib__str_as_bytes *)
letfun new_tests__legacy__proverif_conversions__lib__str_as_bytes(s: bitstring) =
  core__slice__Impl__len(
    (* HAX WARNING: conversion of the library modelled as the identity, although its types are represented differently *) (s)
  ).
(* src: src/legacy/proverif-conversions/lib.rs:38:0-44:1 new_tests__legacy__proverif_conversions__lib__try_into_option *)
letfun new_tests__legacy__proverif_conversions__lib__try_into_option(x: bitstring) =
  let hax__scrut0 = core__result__Impl__unwrap(
    (* HAX WARNING: conversion of the library modelled as the identity, although its types are represented differently *) (x)
  ) in
  let Some(v) = hax__scrut0 in new_tests__legacy__proverif_conversions__lib__record(v)
  else let None() = hax__scrut0 in nat_0
  else bitstring_err().
(* src: src/legacy/proverif-conversions/lib.rs:48:0-55:1 new_tests__legacy__proverif_conversions__lib__converted_branch *)
letfun new_tests__legacy__proverif_conversions__lib__converted_branch(c: bitstring, x: bitstring) =
  let (=True()) = c
    in (* HAX WARNING: conversion of the library modelled as the identity, although its types are represented differently *) (let hax__cond0 = rust_primitives__hax__machine_int__eq(
      x,
      nat_1
    ) in
    let (=True()) = hax__cond0 in nat_2 else nat_3)
    else (let wildcard = new_tests__legacy__proverif_conversions__lib__record(nat_0) in
    None()).
(* src: src/legacy/proverif-conversions/lib.rs:59:0-61:1 new_tests__legacy__proverif_conversions__lib__transposed *)
